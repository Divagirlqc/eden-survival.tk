<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Eden Survival | ARK Ascended Primal Chaos</title>
  <meta name="description" content="Eden Survival — ARK Ascended Primal Chaos | Serveur Crossplay FR / EN" />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
  <style>
    :root{
      --bg:#050608;
      --card:#0b0d12;
      --accent:#ff2b2b;
      --chaos:#b30000;
      --text:#e5e7eb;
      --muted:#9ca3af;
      --danger:#ff4d4d;
    }
    *{box-sizing:border-box}
    body{margin:0;font-family:Inter;background:radial-gradient(900px 500px at 70% -10%,#200000,transparent 60%),var(--bg);color:var(--text);position:relative}
body::after{content:"";position:fixed;inset:0;background:url('eden-survival-logo.png') center/420px no-repeat;opacity:.04;pointer-events:none;filter:drop-shadow(0 0 40px rgba(255,0,0,.35));animation:chaosPulse 8s ease-in-out infinite}
@keyframes chaosPulse{0%,100%{opacity:.035;transform:scale(1)}50%{opacity:.06;transform:scale(1.03)}}
    header{position:sticky;top:0;background:rgba(5,6,8,.85);backdrop-filter:blur(10px);border-bottom:1px solid #220000}
    nav{max-width:1200px;margin:auto;padding:16px 20px;display:flex;justify-content:space-between;align-items:center}
    nav a{color:var(--muted);margin-left:16px;text-decoration:none}
    nav a:hover{color:#fff}
    section{max-width:1200px;margin:90px auto;padding:0 20px}
    h1,h2,h3{font-family:Orbitron;letter-spacing:.06em}
    .hero{display:grid;grid-template-columns:1.2fr .8fr;gap:36px}
    .badge{display:inline-block;border:1px solid #3b0000;border-radius:999px;padding:6px 12px;color:#ff2b2b}
    .btn{display:inline-block;margin-top:18px;padding:14px 22px;border-radius:16px;background:linear-gradient(135deg,#ff2b2b,#7a0000);color:#fff;font-weight:800;text-decoration:none;box-shadow:0 0 25px rgba(255,43,43,.4)}
    .card{background:linear-gradient(180deg,#0b0d12,#020203);border:1px solid #220000;border-radius:20px;padding:24px}
    .grid{display:grid;gap:22px}
    .grid-3{grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
    .price{font-size:24px;font-weight:900;color:#ff2b2b}
    footer{text-align:center;padding:40px 20px;border-top:1px solid #220000;color:var(--muted)}
    @media(max-width:900px){.hero{grid-template-columns:1fr}}
  </style>
</head>
<body>
<header>
  <nav>
    <div class="logo"><img src="eden-survival-logo.png" alt="Eden Survival Logo" style="height:48px;filter:drop-shadow(0 0 12px rgba(255,0,0,.6));"></div>
    <div>
      <a href="#home">Home</a>
      <a href="#shop">Shop</a>
      <a href="#rules">Rules</a>
      <a href="#vote">Vote</a>
      <a href="https://discord.gg/G8sX4j3Hh3" target="_blank">Discord</a>
    </div>
  </nav>
</header>

<section id="home" class="hero">
  <div>
    <span class="badge">ARK ASCENDED • PRIMAL CHAOS</span>
    <h1><span style="color:#ff2b2b">Eden</span> Survival</h1>
    <p class="muted">Serveur Crossplay FR / EN — PVE Primal Chaos. Progression équilibrée, admins actifs, économie saine.</p>
    <a class="btn" href="#shop">Open Shop</a>
  </div>
  <div class="card">
    <h3>Server Info</h3>
    <ul class="muted">
      <li>Rates X20</li>
      <li>Crossplay PC / PS5 / Xbox</li>
      <li>Host: Nitrado</li>
      <li>Currency: Element</li>
    </ul>
  </div>
</section>

<section id="shop">
  <h2>🛒 Official Shop</h2>
  <p class="muted">Rate: <strong>1 € = 150 Element</strong> — PayPal secure payment.</p>
  <div class="grid grid-3">
    <div class="card">
      <h3>Starter Pack</h3>
      <p class="price">5 €</p>
      <p class="muted">750 Element + starter items</p>
    </div>
    <div class="card">
      <h3>Survivor Pack</h3>
      <p class="price">10 €</p>
      <p class="muted">1500 Element + utility dino</p>
    </div>
    <div class="card">
      <h3>Alpha Pack</h3>
      <p class="price">20 €</p>
      <p class="muted">3000 Element + Primal Chaos dino</p>
    </div>
  </div>
  <p class="muted">After purchase: join Discord and open a shop ticket.</p>
</section>

<section id="rules">
  <h2>📜 Rules / Règlement</h2>
  <div class="card">
    <h3>FR</h3>
    <ul class="muted">
      <li>Respect obligatoire entre joueurs</li>
      <li>Aucun cheat, exploit ou bug abuse</li>
      <li>Shop non Pay-to-Win</li>
    </ul>
    <h3>EN</h3>
    <ul class="muted">
      <li>Respect all players</li>
      <li>No cheat, exploit or bug abuse</li>
      <li>Shop is non Pay-to-Win</li>
    </ul>
  </div>
</section>

<section id="vote">
  <h2>🗳️ Vote & Rewards</h2>
  <div class="card">
    <p class="muted">Vote daily on server lists to earn Element rewards. Rewards are claimed via Discord.</p>
  </div>
</section>

<section id="opening">
  <h2>🔥 Opening Event</h2>
  <div class="grid grid-3">
    <div class="card">
      <h3>🎁 Welcome Bonus</h3>
      <p class="muted">Free starter rewards for all new survivors during opening week.</p>
    </div>
    <div class="card">
      <h3>🦖 Dino Events</h3>
      <p class="muted">Special Primal Chaos spawns & mini-events hosted by admins.</p>
    </div>
    <div class="card">
      <h3>💎 Element Boost</h3>
      <p class="muted">Bonus Element rewards via vote & in-game challenges.</p>
    </div>
  </div>
</section>

<footer>
  <p>© 2026 Eden Survival — ARK Ascended Primal Chaos</p>
</footer>
</body>
</html>
